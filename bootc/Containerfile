# Pinned by digest so a kernel move is a reviewable commit rather than tag drift;
# with ZFS in the app tier a kernel that outruns its kmod breaks storage on three
# nodes. Renovate opens these bumps. Index digest for
# ghcr.io/ublue-os/ucore:stable-nvidia-lts 44.20261023.3.1.
FROM ghcr.io/ublue-os/ucore:stable-nvidia-lts@sha256:59d41bc9b29cadf4b3b89afdf66a186c827c5d7dde301bc926bdb2cb3c866724

# renovate: datasource=github-releases depName=k3s-selinux packageName=k3s-io/k3s-selinux
ARG K3S_SELINUX_VERSION=1.6-1
RUN dnf install -y \
  https://rpm.rancher.io/k3s/latest/common/centos/9/noarch/k3s-selinux-${K3S_SELINUX_VERSION}.el9.noarch.rpm \
  wireguard-tools \
  nvme-cli \
  nvmetcli \
  e2fsprogs \
  xfsprogs \
  sg3_utils \
  device-mapper-multipath \
  lsscsi \
  nfs-utils \
  device-mapper \
  cryptsetup \
  && dnf clean all

# renovate: datasource=github-tags depName=k3s packageName=k3s-io/k3s
ARG K3S_VERSION=v1.37.2+k3s1
ADD https://github.com/k3s-io/k3s/releases/download/${K3S_VERSION}/k3s /usr/bin/k3s
RUN chmod +x /usr/bin/k3s

# zrepl (the app-tier replication mesh) is not in Fedora proper; the vendor's
# dnf repo tracks latest, and it is pre-1.0 — so install the release RPM by URL
# and pin the version. The asset is zrepl-<version>-2.x86_64.rpm.
# renovate: datasource=github-releases depName=zrepl packageName=zrepl/zrepl
ARG ZREPL_VERSION=v0.7.0
RUN dnf install -y \
  https://github.com/zrepl/zrepl/releases/download/${ZREPL_VERSION}/zrepl-${ZREPL_VERSION}-2.x86_64.rpm \
  && dnf clean all

COPY overlay/ /

RUN systemctl disable firewalld \
  && systemctl enable cockpit tailscaled iscsid tuned nvmet chronyd zrepl

RUN bootc container lint
