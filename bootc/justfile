dist := justfile_directory() / "dist"
templates := justfile_directory() / "../butane"
coreos_installer := "quay.io/coreos/coreos-installer:release"
butane := "quay.io/coreos/butane:release"

# Render butane/node.bu.j2 for one node and write dist/<hostname>.ign.
# Run from bootc/ (or any directory): paths are resolved against this justfile,
# and butane runs from a container so no host binary is needed.
gen-ignition hostname interface ip:
  #! /usr/bin/env bash
  set -euxo pipefail
  mkdir -p {{dist}}
  minijinja-cli \
    -D hostname={{hostname}} \
    -D interface={{interface}} \
    -D ip={{ip}} \
    {{templates}}/node.bu.j2 \
  | podman run --rm -i {{butane}} --strict --pretty \
  > {{dist}}/{{hostname}}.ign

download-iso:
  #! /usr/bin/env bash
  set -euxo pipefail
  mkdir -p {{dist}}
  podman run --privileged --rm -v {{dist}}:/data \
  {{coreos_installer}} \
  download -s stable -p metal -f iso -a x86_64 -C /data

# Bootable installer that writes the node image setup to `device` and runs the
# dest ignition unattended. `device` has no default: it is overwritten without
# confirmation, and the EliteDesk 705 G4 ships with SATA or NVMe.
#
# Optional third argument: an installer config YAML in `dist/` (see
# gen-installer-config). With it, the embedded install keeps the partitions it
# names — that is how the node-local ZFS pool survives the reinstall.
build-iso hostname device installer_config='':
  #! /usr/bin/env bash
  set -euxo pipefail
  ISO=$(ls {{dist}}/fedora-coreos-*.iso | tail -1 | xargs basename)
  rm -f {{dist}}/{{hostname}}.iso

  EXTRA=()
  if [ -n "{{installer_config}}" ]; then
    EXTRA=(--installer-config "/data/{{installer_config}}")
  fi

  podman run --rm --privileged \
  -v {{dist}}:/data \
  {{coreos_installer}} \
  iso customize \
  --dest-device {{device}} \
  --dest-ignition /data/{{hostname}}.ign \
  "${EXTRA[@]}" \
  --output /data/{{hostname}}.iso \
  "/data/$ISO"

# Installer config that preserves a GPT partition across the install, so the
# `k8s` zpool created on it later is not wiped. Key names are coreos-installer
# long options without the leading "--"; repeatable options are arrays.
# `label` is the GPT partition *label* (`sgdisk -c 5:zfs`), never a filesystem
# label — coreos-installer matches on the partition table.
#
# ⚠️ Do NOT add `dest-device` here. `iso customize --dest-device` already writes
# it to /etc/coreos/installer.d/0001-customize.yaml, and the live service passes
# EVERY file in that directory as its own `--config-file`. dest-device becomes
# the positional device argument, so two files naming it produce two positionals
# and the install dies with "unexpected argument /dev/nvme0n1" before touching
# the disk. Reproduced 2026-11-19; `save-partlabel` alone merges cleanly.
gen-installer-config hostname label:
  #! /usr/bin/env bash
  set -euxo pipefail
  mkdir -p {{dist}}
  printf -- '---\nsave-partlabel:\n  - %s\n' "{{label}}" \
    > {{dist}}/{{hostname}}-install.yaml
  cat {{dist}}/{{hostname}}-install.yaml

# Bench stick: the same live ISO with a live ignition only, so it boots to a
# console with sshd and a known static address and never touches a disk. Use it
# to read `ip -br link`, `lsblk`, `lspci` and run vainfo remotely before deciding
# what to bake into a real installer. Defaults to an address outside the node
# range (drone-01..04 are .21-.24).
bench-iso ip='192.168.42.90':
  #! /usr/bin/env bash
  set -euxo pipefail
  mkdir -p {{dist}}
  ISO=$(ls {{dist}}/fedora-coreos-*.iso | tail -1 | xargs basename)
  rm -f {{dist}}/bench.ign {{dist}}/bench.iso

  minijinja-cli -D ip={{ip}} {{templates}}/live.bu.j2 \
  | podman run --rm -i {{butane}} --strict --pretty \
  > {{dist}}/bench.ign

  podman run --rm --privileged \
  -v {{dist}}:/data \
  {{coreos_installer}} \
  iso customize \
  --live-ignition /data/bench.ign \
  --output /data/bench.iso \
  "/data/$ISO"
