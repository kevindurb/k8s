#!/usr/bin/env bash
# Move one application volume from zfs-generic-nvmeof-csi (democratic-csi, on
# drone-04 over NVMe-oF) to zfs-local (OpenEBS LocalPV-ZFS, node-local), keeping
# the PVC name so git only changes the storageClassName line.
#
# One volume per invocation, by design (docs/storage-placement.md): every step
# reports what it did and the script refuses to continue when a verification
# fails, rather than trying to be re-applied.
#
# Usage:
#   scripts/migrate-volume --app apps/linkding --pvc linkding-data --home drone-03 --dry-run
#   scripts/migrate-volume --app apps/linkding --pvc linkding-data --home drone-03 --yes
#
# The app must be a Kustomize app dir with an app.yml (Argo Application). The pin
# (components/storage-home-<node>) is added automatically unless --no-pin.

set -euo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$REPO"

APP_DIR=""; PVC_ARG=""; HOME_NODE=""; DRY_RUN=0; NO_PIN=0; YES=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --app) APP_DIR=${2:?}; shift 2 ;;
    --pvc) PVC_ARG=${2:?}; shift 2 ;;
    --home) HOME_NODE=${2:?}; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --no-pin) NO_PIN=1; shift ;;
    --yes) YES=1; shift ;;
    -h|--help) sed -n '1,20p' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

step() { printf '\n== %s\n' "$*"; }
info() { printf '   %s\n' "$*"; }
field() { printf '   %-14s %s\n' "$1:" "$2"; }
die()  { printf '\nERROR: %s\n' "$*" >&2; exit 1; }

[[ -n $APP_DIR && -n $PVC_ARG && -n $HOME_NODE ]] || \
  die "--app, --pvc and --home are required (see --help)"
[[ -d $APP_DIR ]] || die "$APP_DIR does not exist"
[[ -f $APP_DIR/app.yml ]] || die "$APP_DIR/app.yml (Argo Application) missing"
case "$HOME_NODE" in drone-01|drone-02|drone-03) ;; *) die "home must be drone-01/02/03" ;; esac

# ---------------------------------------------------------------- derive facts
RENDERED=$(kustomize build "$APP_DIR") || die "kustomize build $APP_DIR failed"

# Accept either the full rendered name or the pre-namePrefix name.
FULL_PVC=$(printf '%s\n' "$RENDERED" | yq -N -r '
  select(.kind == "PersistentVolumeClaim") | .metadata.name' 2>/dev/null |
  grep -x "$PVC_ARG" | head -1) || true
[[ -n $FULL_PVC ]] || FULL_PVC=$(printf '%s\n' "$RENDERED" | yq -N -r '
  select(.kind == "PersistentVolumeClaim") | .metadata.name' 2>/dev/null |
  grep -E "(^|-)${PVC_ARG}$" | head -1) || true
[[ -n $FULL_PVC ]] || die "no PVC matching '$PVC_ARG' in $APP_DIR"

# The manifests declare the PVC by its name *before* namePrefix, which may itself
# contain hyphens (consignment-app- + data), so strip the prefix rather than
# splitting on the first hyphen.
PREFIX=$(yq -r '.namePrefix // ""' "$APP_DIR/kustomization.yml" 2>/dev/null || true)
SHORT_PVC=${FULL_PVC#"$PREFIX"}
[[ -n $SHORT_PVC ]] || SHORT_PVC=$FULL_PVC

PVC_FILTER="select(.kind == \"PersistentVolumeClaim\" and .metadata.name == \"$FULL_PVC\")"
NS=$(printf '%s\n' "$RENDERED" | yq -N -r "$PVC_FILTER | .metadata.namespace" | head -1)
CLASS=$(printf '%s\n' "$RENDERED" | yq -N -r "$PVC_FILTER | .spec.storageClassName" | head -1)
SIZE=$(printf '%s\n' "$RENDERED" | yq -N -r "$PVC_FILTER | .spec.resources.requests.storage" | head -1)
[[ -n $NS && $NS != null ]] || die "could not determine the namespace of $FULL_PVC"
ARGO_APP=$(yq -r '.metadata.name' "$APP_DIR/app.yml")
case "$APP_DIR" in
  apps/*)           PARENT=apps ;;
  platform/*)       PARENT=platform ;;
  infrastructure/*) PARENT=infrastructure ;;
  *) die "APP_DIR must live under apps/, platform/ or infrastructure/" ;;
esac

# ---------------------------------------------------------------- preflight
step "preflight"
[[ -z $(git status --porcelain) ]] || die "working tree is dirty; commit or stash first"
info "working tree clean"

[[ $CLASS == zfs-generic-nvmeof-csi ]] || die "$FULL_PVC is on '$CLASS', not zfs-generic-nvmeof-csi"
LIVE_CLASS=$(kubectl -n "$NS" get pvc "$FULL_PVC" -o jsonpath='{.spec.storageClassName}')
[[ $LIVE_CLASS == zfs-generic-nvmeof-csi ]] || die "live PVC class is '$LIVE_CLASS'"
OLD_PV=$(kubectl -n "$NS" get pvc "$FULL_PVC" -o jsonpath='{.spec.volumeName}')
info "live PVC ok"

# A volume shared by two workloads cannot move: zfs-localpv refuses a second
# mount of the same RWO PV on one node ("verifyMount: device already mounted").
WORKLOADS=$(kubectl get pods -A -o json | jq -r --arg ns "$NS" --arg c "$FULL_PVC" '
  [ .items[] | select(.metadata.namespace == $ns)
    | select([.spec.volumes[]? | select(.persistentVolumeClaim.claimName? == $c)] | length > 0)
    | (.metadata.ownerReferences[0].kind + "/" + .metadata.ownerReferences[0].name) ]
  | map(if startswith("ReplicaSet/") then "Deployment/" + (.[11:] | sub("-[a-z0-9]+$"; "")) else . end)
  | unique | .[]')
NWORK=$(printf '%s\n' "$WORKLOADS" | grep -c . || true)
[[ $NWORK -eq 1 ]] || die "$FULL_PVC is mounted by $NWORK workloads ($(echo "$WORKLOADS" | tr '\n' ' ')) - zfs-localpv can only serve one"
info "single consumer"

timeout 20 ssh -o BatchMode=yes "$HOME_NODE" 'zpool list -H -o name k8s' >/dev/null ||
  die "$HOME_NODE has no k8s pool"
info "$HOME_NODE k8s pool present"

# Find the source file that declares this PVC, and prove the class line is there.
# Doing it now means a manifest we cannot edit fails before anything is destroyed.
TARGET_FILE=$(python3 - "$APP_DIR" "$SHORT_PVC" <<'PY2'
import os, re, sys
app_dir, short = sys.argv[1], sys.argv[2]
for f in sorted(os.listdir(app_dir)):
    if not f.endswith((".yml", ".yaml")):
        continue
    for b in re.split(r"(?m)^---\s*$", open(os.path.join(app_dir, f)).read()):
        if "PersistentVolumeClaim" in b and re.search(rf"(?m)^\s*name:\s*{re.escape(short)}\s*$", b):
            if "storageClassName: zfs-generic-nvmeof-csi" in b:
                print(os.path.join(app_dir, f)); raise SystemExit(0)
            raise SystemExit(f"{f}: PVC {short} found but its class is not zfs-generic-nvmeof-csi")
raise SystemExit(f"no PVC block named {short} in {app_dir}")
PY2
) || die "cannot edit the manifest: $TARGET_FILE"
info "manifest editable"

if [[ $NO_PIN -eq 0 && ! -d components/storage-home-$HOME_NODE ]]; then
  die "components/storage-home-$HOME_NODE does not exist"
fi

# ------------------------------------------------------- read-only fact gathering
# Everything below is for the report; no mutations yet.
SOURCED_BYTES="-"
SNAPSHOTS="-"
if timeout 15 ssh -o BatchMode=yes drone-04 "sudo zfs list -H -o name rust/k8s/volumes/$OLD_PV" >/dev/null 2>&1; then
  # usedbydataset is the live data that will actually be copied; `used` would
  # include the sanoid history.
  SOURCED_BYTES=$(timeout 15 ssh -o BatchMode=yes drone-04 \
    "sudo zfs get -Hp -o value usedbydataset rust/k8s/volumes/$OLD_PV" 2>/dev/null |
    awk '{ if ($1 > 1073741824) printf "%.1f GiB", $1/1073741824; else printf "%.1f MiB", $1/1048576 }')
  SNAPSHOTS=$(timeout 15 ssh -o BatchMode=yes drone-04 \
    "sudo zfs list -t snapshot -H -o name -d1 rust/k8s/volumes/$OLD_PV 2>/dev/null | wc -l")
fi
NODE_FREE=$(timeout 15 ssh -o BatchMode=yes "$HOME_NODE" \
  "zpool list -Hp -o free k8s" 2>/dev/null | awk '{printf "%.0f GiB", $1/1073741824}') || NODE_FREE="?"
SCALED_LIST=$(for kind in deploy sts; do
  kubectl -n "$NS" get "$kind" -o json 2>/dev/null |
    jq -r '.items[] | "      \(.kind)/\(.metadata.name)  replicas=\(.spec.replicas // 1)"'
done)
PIN_STATE="will add components/storage-home-$HOME_NODE"
grep -q "storage-home-$HOME_NODE" "$APP_DIR/kustomization.yml" && PIN_STATE="already pinned"

step "report"
field "app" "$APP_DIR  (Argo '$ARGO_APP', chain borg -> $PARENT -> $ARGO_APP)"
field "namespace" "$NS"
field "pvc" "$FULL_PVC  (declared as '$SHORT_PVC' + prefix '$PREFIX')"
field "size" "$SIZE, currently $CLASS"
field "old pv" "$OLD_PV"
field "source used" "$SOURCED_BYTES, $SNAPSHOTS sanoid snapshot(s)"
field "home node" "$HOME_NODE, pool free $NODE_FREE"
field "pin" "$PIN_STATE"
field "manifest" "$TARGET_FILE"
field "consumer" "$(echo "$WORKLOADS" | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
echo "   workloads that will be scaled to 0 and restored:"
printf '%s\n' "${SCALED_LIST:-      (none)}"

if [[ $DRY_RUN -eq 1 ]]; then
  step "plan (dry run: nothing has been changed)"
  info "1. pause borg -> $PARENT -> $ARGO_APP"
  info "2. scale $NS to 0, wait for $OLD_PV's VolumeAttachment to go"
  info "3. create PVC ${FULL_PVC}-migrate ($SIZE, zfs-local) and Job migrate-${FULL_PVC}"
  info "   on $HOME_NODE: rsync -aHAX --numeric-ids --exclude lost+found /old/ /new/"
  info "4. verify file count and byte total on both sides, then remove the Job"
  info "5. patch the new PV to Retain, delete the temp PVC, patch $OLD_PV to Retain,"
  info "   delete PVC $FULL_PVC, pre-bind the new PV to $NS/$FULL_PVC"
  info "6. edit $TARGET_FILE (class -> zfs-local) + $APP_DIR/kustomization.yml (pin),"
  info "   kustomize build, commit, push"
  info "7. sync $ARGO_APP explicitly to that revision (a stale revision recreates the"
  info "   PVC on the old class, and storageClassName is immutable)"
  info "8. restore the replicas above, resume $ARGO_APP -> $PARENT -> borg, verify"
  step "what is NOT touched"
  info "$OLD_PV stays Retain/Released with its zvol and snapshots for rollback"
  info "no manifest other than the two files above; no other namespace"
  step "expected duration"
  info "copy of $SOURCED_BYTES plus ~20s of kubectl work; large volumes are"
  info "disk-bound (the 318 GiB immich move ran at 20-40 MB/s on drone-04's HDDs)"
  exit 0
fi

[[ $YES -eq 1 ]] || die "refusing to touch the cluster without --yes (or use --dry-run)"

# ---------------------------------------------------------------- save state
SCALED_DIR=$(mktemp -d)
trap 'rm -rf "$SCALED_DIR"' EXIT
for kind in deploy sts; do
  kubectl -n "$NS" get "$kind" -o json |
    jq -r '.items[] | "\(.metadata.name) \(.spec.replicas // 1)"' > "$SCALED_DIR/$kind" || true
done

pause_app() {
  kubectl -n argocd patch app "$1" --type json \
    -p '[{"op":"remove","path":"/spec/syncPolicy/automated"}]' >/dev/null 2>&1 || true
}
resume_app() {
  kubectl -n argocd patch app "$1" --type json \
    -p '[{"op":"add","path":"/spec/syncPolicy/automated","value":{"enabled":true,"prune":false,"selfHeal":true}}]' \
    >/dev/null 2>&1 || true
}

step "pause Argo (borg -> $PARENT -> $ARGO_APP)"
for a in borg "$PARENT" "$ARGO_APP"; do pause_app "$a"; info "$a paused"; done

step "scale $NS to 0"
kubectl -n "$NS" scale deploy,sts --all --replicas=0 >/dev/null 2>&1 || true
for _ in $(seq 1 60); do
  [[ -z $(kubectl -n "$NS" get pods --no-headers 2>/dev/null | grep -v Terminating || true) ]] && break
  sleep 2
done
info "no pods left in $NS"

step "wait for $OLD_PV to detach"
for _ in $(seq 1 90); do
  n=$(kubectl get volumeattachment --no-headers 2>/dev/null | grep -c "$OLD_PV" || true)
  [[ $n -eq 0 ]] && break
  sleep 2
done
[[ ${n:-0} -eq 0 ]] || die "$OLD_PV still has a VolumeAttachment"
info "detached"

step "create ${FULL_PVC}-migrate on zfs-local"
kubectl -n "$NS" apply -f - >/dev/null <<EOF
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: ${FULL_PVC}-migrate
  labels:
    migrate-volume: "true"
spec:
  accessModes: [ReadWriteOnce]
  storageClassName: zfs-local
  resources:
    requests:
      storage: ${SIZE}
EOF
info "created"

step "copy with a Job on $HOME_NODE"
kubectl -n "$NS" apply -f - >/dev/null <<EOF
apiVersion: batch/v1
kind: Job
metadata:
  name: migrate-${FULL_PVC}
  labels:
    migrate-volume: "true"
spec:
  backoffLimit: 0
  template:
    spec:
      restartPolicy: Never
      nodeSelector:
        kubernetes.io/hostname: ${HOME_NODE}
      containers:
        - name: copy
          image: docker.io/library/alpine:3.21
          command:
            - sh
            - -c
            - |
              apk add --no-cache rsync >/dev/null 2>&1
              rsync -aHAX --numeric-ids --exclude lost+found /old/ /new/
              echo "OLD_FILES=\$(find /old -type f | wc -l)"
              echo "NEW_FILES=\$(find /new -type f | wc -l)"
              echo "OLD_BYTES=\$(find /old -type f -exec stat -c %s {} + | awk '{s+=\$1} END {print s+0}')"
              echo "NEW_BYTES=\$(find /new -type f -exec stat -c %s {} + | awk '{s+=\$1} END {print s+0}')"
          volumeMounts:
            - name: old
              mountPath: /old
              readOnly: true
            - name: new
              mountPath: /new
      volumes:
        - name: old
          persistentVolumeClaim:
            claimName: ${FULL_PVC}
            readOnly: true
        - name: new
          persistentVolumeClaim:
            claimName: ${FULL_PVC}-migrate
EOF
kubectl -n "$NS" wait --for=condition=complete --timeout=30m "job/migrate-${FULL_PVC}" >/dev/null ||
  die "copy Job did not complete; inspect: kubectl -n $NS logs job/migrate-${FULL_PVC}"

LOGS=$(kubectl -n "$NS" logs "job/migrate-${FULL_PVC}")
OF=$(sed -n 's/^OLD_FILES=//p' <<<"$LOGS"); NF=$(sed -n 's/^NEW_FILES=//p' <<<"$LOGS")
OB=$(sed -n 's/^OLD_BYTES=//p' <<<"$LOGS"); NB=$(sed -n 's/^NEW_BYTES=//p' <<<"$LOGS")
info "files: $OF -> $NF    bytes: $OB -> $NB"
[[ $OF == "$NF" && $OB == "$NB" ]] || die "copy verification failed; nothing has been changed in git"

# A completed Job pod still references the temp PVC, and pvc-protection will not
# let the PVC go until the pod is gone - deleting the PVC first hangs forever.
step "remove the copy Job"
kubectl -n "$NS" delete job "migrate-${FULL_PVC}" --wait=true --timeout=180s >/dev/null
info "job and pod removed"

step "rebind the new PV to $NS/$FULL_PVC"
NEW_PV=$(kubectl -n "$NS" get pvc "${FULL_PVC}-migrate" -o jsonpath='{.spec.volumeName}')
kubectl patch pv "$NEW_PV" -p '{"spec":{"persistentVolumeReclaimPolicy":"Retain"}}' >/dev/null
kubectl -n "$NS" delete pvc "${FULL_PVC}-migrate" --wait=true --timeout=180s >/dev/null
kubectl patch pv "$OLD_PV" -p '{"spec":{"persistentVolumeReclaimPolicy":"Retain"}}' >/dev/null
kubectl -n "$NS" delete pvc "$FULL_PVC" --wait=true --timeout=180s >/dev/null
kubectl patch pv "$NEW_PV" --type json \
  -p "[{\"op\":\"replace\",\"path\":\"/spec/claimRef\",\"value\":{\"namespace\":\"$NS\",\"name\":\"$FULL_PVC\"}}]" >/dev/null
info "new PV $NEW_PV pre-bound; old PV $OLD_PV kept Retain/Released"

step "git: pin to $HOME_NODE and switch the class"
python3 - "$APP_DIR" "$HOME_NODE" "$SHORT_PVC" "$NO_PIN" "$TARGET_FILE" <<'PY'
import os, re, sys
app_dir, node, short, no_pin, target = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4] == "1", sys.argv[5]

# 1. the pin component
kfile = os.path.join(app_dir, "kustomization.yml")
src = open(kfile).read()
comp = f"../../components/storage-home-{node}"
if not no_pin and comp not in src:
    if "components:" in src:
        src = src.replace("components:\n", f"components:\n  - {comp}\n", 1)
    else:
        src = src.replace("configMapGenerator:", f"components:\n  - {comp}\n\nconfigMapGenerator:", 1)
    open(kfile, "w").write(src)
    print(f"   pin added to {kfile}")

# 2. the storageClassName, in the file preflight already validated
text = open(target).read()
blocks = re.split(r"(?m)^---\s*$", text)
changed = False
for i, b in enumerate(blocks):
    if re.search(rf"(?m)^\s*name:\s*{re.escape(short)}\s*$", b) and "PersistentVolumeClaim" in b:
        if "storageClassName: zfs-generic-nvmeof-csi" in b:
            blocks[i] = b.replace("storageClassName: zfs-generic-nvmeof-csi",
                                  "storageClassName: zfs-local")
            open(target, "w").write("---".join(blocks))
            print(f"   class switched in {target}")
            changed = True
if not changed:
    sys.exit("could not find the PVC block to edit")
PY

kustomize build "$APP_DIR" >/dev/null || die "kustomize build failed after the edit; git checkout and re-run"
git add "$APP_DIR"
git commit -q -m "feat(${ARGO_APP}): ${FULL_PVC} on zfs-local (${HOME_NODE})

Migrated with scripts/migrate-volume: copied by a Job on ${HOME_NODE},
verified $OF files / $OB bytes on both sides, then rebound to the original claim
name. Pinned to ${HOME_NODE} with components/storage-home-${HOME_NODE}. Old PV
${OLD_PV} kept Retain/Released for rollback."
git push -q origin HEAD
REV=$(git rev-parse HEAD)
info "pushed $REV"

step "sync Argo to $REV explicitly"
kubectl -n argocd patch app "$ARGO_APP" --type merge \
  -p "{\"operation\":{\"sync\":{\"revision\":\"$REV\"}}}" >/dev/null
for _ in $(seq 1 60); do
  lc=$(kubectl -n "$NS" get pvc "$FULL_PVC" -o jsonpath='{.spec.storageClassName}' 2>/dev/null || true)
  [[ $lc == zfs-local ]] && break
  sleep 2
done
[[ ${lc:-} == zfs-local ]] || die "PVC did not come back on zfs-local; see $REV"
info "PVC recreated on zfs-local"

step "restore replicas and resume Argo"
for kind in deploy sts; do
  while read -r name replicas; do
    [[ -n $name ]] || continue
    kubectl -n "$NS" scale "$kind/$name" --replicas="$replicas" >/dev/null 2>&1 || true
  done < "$SCALED_DIR/$kind"
done
for a in "$ARGO_APP" "$PARENT" borg; do resume_app "$a"; info "$a resumed"; done

step "verify"
kubectl -n "$NS" wait --for=condition=Ready pod --all --timeout=300s >/dev/null 2>&1 || \
  info "warning: not every pod is Ready yet (see below)"
kubectl -n "$NS" get pods --no-headers || true
echo
kubectl -n "$NS" get pvc "$FULL_PVC" -o custom-columns='PVC:.metadata.name,VOLUME:.spec.volumeName,CLASS:.spec.storageClassName,STATUS:.status.phase'
kubectl get pv "$OLD_PV" -o custom-columns='OLD-PV:.metadata.name,STATUS:.status.phase,POLICY:.spec.persistentVolumeReclaimPolicy'
printf '   zvol on %s: ' "$HOME_NODE"
ssh -o BatchMode=yes "$HOME_NODE" "sudo zfs list -H -o name k8s/volumes/$NEW_PV 2>/dev/null || echo missing"
printf '   Argo %s: ' "$ARGO_APP"
kubectl -n argocd get app "$ARGO_APP" -o jsonpath='{.status.sync.status} {.status.health.status}{"\n"}'

step "done"
info "rollback if the app misbehaves: pause Argo, delete PVC $FULL_PVC,"
info "clear the old PV claimRef (kubectl patch pv $OLD_PV), git revert $REV"
info "note: $OLD_PV keeps $SNAPSHOTS sanoid snapshot(s), which block a delete until"
info "      'zfs destroy -r rust/k8s/volumes/$OLD_PV' on drone-04"
