default:
  @just --list

ansible *args:
  ansible -i ./inventory/prod.yml {{args}}

playbook *args:
  ansible-playbook -i ./inventory/prod.yml {{args}}

adhoc module filter='all':
  just ansible -m {{module}} {{filter}}

sudo-adhoc module filter='all':
  just ansible -b -m {{module}} {{filter}}

ping filter='all':
  just adhoc ping {{filter}}

# Raw reboot (no drain). The filter is required and "all" is rejected so a stray
# `just reboot` can't take down every node, drone-04 (storage) included.
reboot filter:
  @if [ "{{filter}}" = "all" ]; then echo "refusing to reboot 'all': name the hosts (never drone-04, use reboot-drone-04.yml)" >&2; exit 1; fi
  just sudo-adhoc reboot {{filter}}

shutdown filter='all':
  just sudo-adhoc community.general.shutdown {{filter}}
