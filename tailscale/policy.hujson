// vim: set ft=hjson:

{
	"groups": {},
	"hosts":  {},

	"tagOwners": {
		"tag:pve":          ["autogroup:admin"],
		"tag:ci":           ["autogroup:admin"],
		"tag:infra":        ["autogroup:admin"],
		"tag:work":         ["autogroup:admin"],
		"tag:personal":     ["autogroup:admin"],
		"tag:k8s-operator": ["autogroup:admin"],
		"tag:k8s":          ["tag:k8s-operator"],
		"tag:dev-pod":      ["autogroup:admin"],
		"tag:k8s-node":     ["autogroup:admin"],
		"tag:golink":       ["autogroup:admin"],
	},

	"nodeAttrs": [
		{
			"target": ["autogroup:member", "tag:k8s"],
			"attr":   ["funnel"],
		},
		{
			"target": ["100.101.43.87"],
			"attr":   ["mullvad"],
		},
    {
      "target": ["autogroup:member", "autogroup:tagged"],
      "attr": [
        "drive:share",
        "drive:access",
      ],
    },
	],

	"ssh": [
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["root", "autogroup:nonroot"],
		},
		{
			"action": "accept",
			"src":    ["autogroup:admin"],
			"dst":    ["autogroup:tagged"],
			"users":  ["root", "autogroup:nonroot"],
		},
	],

	"grants": [
		{
			"src": ["*"],
			"dst": ["*"],
			"ip":  ["*"],
		},
    {
      "src": ["autogroup:member"],
      "dst": ["autogroup:self"],
      "app": {
        "tailscale.com/cap/drive": [{
        "shares": ["*"],
        "access": "rw"
        }]
      }
    },
    {
      "src": ["autogroup:admin"],
      "dst": ["autogroup:tagged"],
      "app": {
        "tailscale.com/cap/drive": [{
        "shares": ["*"],
        "access": "rw"
        }]
      }
    },
	],

	"autoApprovers": {
    "services": {
      "svc:*": ["tag:k8s"],
    },
  },
}
