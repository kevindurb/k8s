# Nonsecret Rakazo settings, rendered into the rakazo-config ConfigMap.
#
# Rakazo reads settings when a process starts, and this ConfigMap has no name
# suffix hash, so a change here does NOT restart anything. Roll the api, worker
# and web Deployments after editing it (see docs/rakazo.md).
NODE_ENV=production
DATA_DIR=/data
CONTENT_ENCRYPTION=on
SECRET_STORE=encrypted
WAKEUP_DRIVER=graphile
AGENT_RUNTIME=pi
API_HOST=0.0.0.0
API_PORT=3100
API_PROXY_TARGET=http://rakazo-api:3100

# One HTTPS origin for cookies, CORS and the mobile client. The tailnet name is
# the only address the ingress serves; the service names are added because the
# web server rejects any other Host header and Gatus probes the ClusterIP.
RAKAZO_HOST=rakazo.beaver-cloud.ts.net
BETTER_AUTH_URL=https://rakazo.beaver-cloud.ts.net
WEB_ORIGIN=https://rakazo.beaver-cloud.ts.net
API_URL=https://rakazo.beaver-cloud.ts.net
RAKAZO_ALLOWED_HOSTS=rakazo.beaver-cloud.ts.net,rakazo-web.rakazo.svc.cluster.local,rakazo-web.rakazo

# Real hop identities: the web pods, and the shared tailscale ingress proxies.
# Without these every request looks like it came from the web pod.
TRUSTED_PROXIES=rakazo-web-peers.rakazo.svc.cluster.local,rakazo-ingress-peers.tailscale.svc.cluster.local

# SSO-only. Pocket ID is the only interactive sign-in method; passkeys are off
# in this mode, and the password credential row stays in the database as an
# operator recovery path (flip this back to true and sync to use it).
AUTH_PASSWORD_ENABLED=false
SIGNUPS_ENABLED=false
SIGNUP_ALLOWLIST=kevindurb@fastmail.com
OWNER_EMAIL=kevindurb@fastmail.com
EMAIL_PROVIDER=none

# App-native OIDC against Pocket ID. The client secret is not here: it is in
# the rakazo-oidc Secret and mounted on the API only. Signups stay closed, so
# SSO cannot create an account; the owner links its identity from a session.
OIDC_ISSUER=https://idp.beaver-cloud.ts.net
OIDC_CLIENT_ID=rakazo
OIDC_NAME=Pocket ID
OIDC_SCOPES=openid email profile

# Computers are sandbox Pods; the image here is the single source of truth and
# is rendered into the admission policy by a kustomize replacement. Keep this
# release paired with the app image (see docs/rakazo.md).
SANDBOX_PROVIDER=kubernetes
KUBERNETES_SANDBOX_NAMESPACE=rakazo-sandboxes
# renovate: datasource=docker depName=ghcr.io/elie222/rakazo/computer
KUBERNETES_SANDBOX_COMPUTER_IMAGE=ghcr.io/elie222/rakazo/computer:v0.12.0@sha256:fceeee2f6eb34ca3a3cd6f83f6dbf30cd276c6edf9ccfab0c7ec22946a5bb1ad
PREVIOUS_COMPUTER_IMAGE=
KUBERNETES_SANDBOX_CPU_LIMIT=2
KUBERNETES_SANDBOX_MEMORY_LIMIT=4Gi
KUBERNETES_SANDBOX_READY_TIMEOUT_MS=300000
SANDBOX_MAX_COMPUTERS_PER_USER=2
COMPUTER_MAX_ACTIVE_UNBILLED_MS=1800000

DB_POOL_MAX=10
RAYON_NUM_THREADS=4

# Remote MCP servers and model connections normally have to resolve to public
# addresses. Aperture's MCP endpoint (https://ai.beaver-cloud.ts.net/v1/mcp)
# resolves in-cluster to the tailnet egress proxies' ClusterIP, so attaching it
# as a connector needs this. Deployment-wide by design: every user may point an
# MCP server at a private address (cloud metadata and link-local stay blocked).
# There is one account here and signups are closed, so that is the operator's
# own capability. Leave unset on a public install.
MCP_ALLOW_PRIVATE_ENDPOINT=true

# Models through the in-cluster Aperture gateway. Aperture authorizes by tailnet
# identity (the ai-egress proxies, tag:k8s-ai), so the key is a placeholder it
# ignores. Output tokens are capped explicitly: these are reasoning models, and
# an unset cap is consumed by the reasoning trace.
RAKAZO_LOCAL_MODELS=deepseek-v4.1-flash
RAKAZO_LOCAL_MODELS_URL=https://ai.beaver-cloud.ts.net/v1
RAKAZO_LOCAL_MODELS_API_KEY=aperture-identity
RAKAZO_LOCAL_CONTEXT_WINDOW=131072
RAKAZO_LOCAL_MAX_TOKENS=8192
RAKAZO_LOCAL_REASONING_MODELS=deepseek-v4.1-flash
PI_DEFAULT_PROVIDER=local
PI_DEFAULT_MODEL=deepseek-v4.1-flash
PI_DEFAULT_CREDENTIALS=host
