        "justifyMode": "auto",
        "showPercentChange": false
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "zrepl endpoints up",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
